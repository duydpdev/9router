# ───────────────────────────────────────────────────────────────────────────
# 9router — optional nginx booster (coarse pre-filter in front of the app).
# This is a TEMPLATE. The app already enforces bot protection on its own; nginx
# here is an extra, faster outer layer. Copy the relevant blocks into your site
# config and adjust server_name / upstream. See docs/bot-protection.md.
# ───────────────────────────────────────────────────────────────────────────

# --- Rate + connection zones (put in the http{} context) ---
limit_req_zone  $binary_remote_addr zone=9r_req:10m  rate=10r/s;
limit_conn_zone $binary_remote_addr zone=9r_conn:10m;

# --- Bad / scanner user-agents → 444 (drop connection, no response) ---
# $binary_remote_addr is the REAL socket IP — not the forgeable X-Forwarded-For.
map $http_user_agent $9r_bad_ua {
    default                 0;
    ""                      1;   # empty UA
    ~*(sqlmap|nikto|masscan|zgrab|nmap|nessus|acunetix|wpscan)  1;
}

server {
    listen 80;
    server_name your-domain.example;

    # Set a trustworthy forwarded IP for the app. With this in place you MAY
    # enable botProtection.trustProxy=true in the dashboard.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header Host            $host;

    # Global coarse limits (burst tolerates short spikes from real clients).
    limit_req  zone=9r_req burst=20 nodelay;
    limit_conn 9r_conn 20;

    # Drop known scanners outright.
    if ($9r_bad_ua) { return 444; }

    # Probe paths → 444 before they ever reach the app.
    location ~* /\.(env|git|aws)        { return 444; }
    location ~* /(wp-login\.php|wp-admin|phpmyadmin|xmlrpc\.php) { return 444; }

    location / {
        proxy_pass http://127.0.0.1:20128;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;   # long-lived SSE streams
    }
}
